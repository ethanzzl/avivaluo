{
  "name": "avivaluo-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate && next build",
    "start": "next start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit --incremental false",
    "validate": "node scripts/validate-content.mjs",
    "images:protect": "node scripts/protect-images.mjs",
    "images:sign": "node scripts/protect-images.mjs --sign-only",
    "images:about": "node scripts/prepare-about-images.mjs"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.6",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "type": "module"
}
